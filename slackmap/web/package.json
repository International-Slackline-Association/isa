{
  "name": "slackmap-web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "checkTs": "tsc --noEmit",
    "start": "VITE_APP_SLACKMAP_MAPBOX_TOKEN=$(aws ssm get-parameter --name slackmap-mapbox-tokens --query Parameter.Value --output text --profile isa-admin --region eu-central-1 | node -pe \"JSON.parse(require('fs').readFileSync(0)).dev\") vite dev --host",
    "build": "VITE_APP_SLACKMAP_MAPBOX_TOKEN=$(aws ssm get-parameter --name slackmap-mapbox-tokens --query Parameter.Value --output text --profile isa-admin --region eu-central-1 | node -pe \"JSON.parse(require('fs').readFileSync(0)).prod\") vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "@mapbox/mapbox-gl-draw-static-mode": "1.0.1",
    "@mapbox/mapbox-gl-geocoder": "5.1.3",
    "@mui/icons-material": "9.5.0",
    "@mui/lab": "9.0.0-beta.10",
    "@mui/material": "9.5.0",
    "@reduxjs/toolkit": "2.13.0",
    "@turf/turf": "7.4.0",
    "aws-amplify": "6.22.2",
    "date-fns": "4.4.0",
    "formik": "2.4.9",
    "html-react-parser": "6.1.9",
    "mapbox-gl": "3.34.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "8.1.3",
    "react-redux": "9.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "1.4.9",
    "@types/mapbox__mapbox-gl-geocoder": "5.1.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "author": {
    "name": "Can Sahin"
  },
  "engines": {
    "node": ">=24"
  }
}
